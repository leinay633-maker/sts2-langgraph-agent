{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "shared/src/**/*.ts",
    "bridge-runtime/src/**/*.ts",
    "mcp-server/src/**/*.ts",
    "langgraph-runner/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
